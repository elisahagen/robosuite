<mujoco model="robotic_cell_base">
  <asset>
    <!-- Floor & walls textures -->
    <texture builtin="flat" height="512" width="512" rgb1="0.8 0.8 0.8" name="tex-floor"/>
    <texture file="../textures/light-gray-plaster.png" type="2d" name="tex-wall"/>
    
    <material name="floor_mat" texture="tex-floor" texrepeat="4 4" reflectance="0.01"/>
    <material name="wall_mat" texture="tex-wall" texrepeat="3 3" specular="0.1" shininess="0.1"/>
    
    <material name="blue-bin" rgba="0.2 0.4 1 1" specular="0.3" shininess="0.1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- Floor -->
    <geom name="floor" type="plane" pos="0 0 0" size="4 4 0.1" material="floor_mat"/>

    <!-- Safety walls (visual-only) -->
    <geom type="box" size="4 0.05 1.5" pos="0 -2 1.5" material="wall_mat" contype="0" conaffinity="0"/>
    <geom type="box" size="4 0.05 1.5" pos="0 2 1.5" material="wall_mat" contype="0" conaffinity="0"/>
    <geom type="box" size="0.05 4 1.5" pos="-2 0 1.5" material="wall_mat" contype="0" conaffinity="0"/>
    <geom type="box" size="0.05 4 1.5" pos="2 0 1.5" material="wall_mat" contype="0" conaffinity="0"/>

    <!-- Bin 1 -->
    <body name="bin1" pos="0.6 -0.4 0.05">
      <geom name="bin1_base" type="box" size="0.25 0.2 0.02" pos="0 0 0.02" material="blue-bin"/>
      <geom name="bin1_wall_back" type="box" size="0.25 0.01 0.1" pos="0 0.21 0.12" material="blue-bin"/>
      <geom name="bin1_wall_front" type="box" size="0.25 0.01 0.1" pos="0 -0.21 0.12" material="blue-bin"/>
      <geom name="bin1_wall_left" type="box" size="0.01 0.2 0.1" pos="-0.26 0 0.12" material="blue-bin"/>
      <geom name="bin1_wall_right" type="box" size="0.01 0.2 0.1" pos="0.26 0 0.12" material="blue-bin"/>
    </body>

    <!-- Bin 2 -->
    <body name="bin2" pos="0.6 0.4 0.05">
      <geom name="bin2_base" type="box" size="0.25 0.2 0.02" pos="0 0 0.02" material="blue-bin"/>
      <geom name="bin2_wall_back" type="box" size="0.25 0.01 0.1" pos="0 0.21 0.12" material="blue-bin"/>
      <geom name="bin2_wall_front" type="box" size="0.25 0.01 0.1" pos="0 -0.21 0.12" material="blue-bin"/>
      <geom name="bin2_wall_left" type="box" size="0.01 0.2 0.1" pos="-0.26 0 0.12" material="blue-bin"/>
      <geom name="bin2_wall_right" type="box" size="0.01 0.2 0.1" pos="0.26 0 0.12" material="blue-bin"/>
    </body>

    <!-- Light -->
    <light pos="1.5 1.5 2.5" dir="-0.3 -0.3 -1" directional="true" diffuse="0.8 0.8 0.9" specular="0.3 0.3 0.3"/>

    <!-- Cameras -->
    <camera name="top_view" mode="fixed" pos="1.2 0 2.5" quat="0.707 0 0 0.707"/>
    <camera name="diagonal_view" mode="fixed" pos="1.5 -1.5 1.5" quat="0.6 0.4 0.4 0.6"/>
  </worldbody>
</mujoco>
